# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Firebase's Apple SDK contains Swift pods. React Native Firebase supports
# these as static frameworks when CocoaPods framework linkage is enabled.
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'PizzaWala' do
  config = use_native_modules!
  use_frameworks! :linkage => :static if linkage == nil

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # React Native Permissions handlers (vendored podspecs pointing to node_modules)
  pod 'Permission-LocationWhenInUse', :path => './PermissionsPods/Permission-LocationWhenInUse.podspec'
  pod 'Permission-LocationAlways', :path => './PermissionsPods/Permission-LocationAlways.podspec'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # React Native 0.83.1 ships fmt 11.0.2, whose consteval detection is
    # incompatible with Apple Clang in Xcode 26.4 and newer. Keep this patch
    # scoped to the generated pod and remove it after React Native upgrades fmt.
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      contents = File.read(fmt_base)
      patched = contents.gsub(
        /^(#elif defined\(__cpp_consteval\)\n#  define FMT_USE_CONSTEVAL) 1/,
        "// Xcode 26 workaround: disable fmt 11.0.2 consteval\n\\1 0"
      )
      if patched != contents
        File.chmod(0644, fmt_base)
        File.write(fmt_base, patched)
      end
    end
  end
end
